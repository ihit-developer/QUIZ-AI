PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/quizese

JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Anthropic Claude API (optional for mock fallbacks)
ANTHROPIC_API_KEY=

# Email / Nodemailer (for password reset, verification)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Quizese Support <no-reply@quizese.app>"

# Recommended for deployed Live Arena rooms (Upstash or another Redis provider)
REDIS_URL=rediss://:password@your-redis-host:6379
